# Google AI Studio key. Extraction and answer writing use Gemini.
GEMINI_API_KEY=
# Change only if your key cannot use the default model.
GEMINI_MODEL=gemini-3.5-flash

# Local Docker Neo4j (see README) or an AuraDB instance (neo4j+s://...).
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=whygraph-local

# Only needed to re-collect GitHub history with npm run collect.
GITHUB_TOKEN=

# Optional. Set this on the server to enable the opt-in Sarvam explanation.
SARVAM_API_KEY=
NEO4J_DATABASE=neo4j
# For hosted deployments set this to the exact public HTTPS origin.
APP_ORIGIN=

# Account service. Generate with openssl rand -base64 48.
BETTER_AUTH_SECRET=
# Use an absolute path on a persistent volume for hosted accounts.
ACCOUNT_DATABASE=.local/accounts.sqlite
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
